post_install() {
    echo ":: [PRESHADER] Auto-configuring RecogD Preshader Unified Control Deck & Permanent System Tray..."
    update-desktop-database -q /usr/share/applications 2>/dev/null || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true

    TARGET_USER="${SUDO_USER:-$USER}"
    if [ -n "$TARGET_USER" ] && [ "$TARGET_USER" != "root" ]; then
        TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
        TARGET_UID="$(id -u "$TARGET_USER" 2>/dev/null || echo 1000)"
        if [ -d "$TARGET_HOME" ] && [ -x /opt/preshader/install.sh ]; then
            su - "$TARGET_USER" -c "DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${TARGET_UID}/bus /opt/preshader/install.sh" 2>/dev/null || true
        fi
    fi
    echo ":: [PRESHADER] Setup complete! Launch via 'preshader' in terminal or from your Application Menu."
}

post_upgrade() {
    post_install
}
