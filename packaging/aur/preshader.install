post_install() {
    echo ":: RecogD is installed. Enable background startup with:"
    echo "::   systemctl --user enable --now recogd-preshader.service"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo ":: To stop and disable RecogD before removal, run:"
    echo "::   systemctl --user disable --now recogd-preshader.service"
}
